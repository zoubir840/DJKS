<!doctype html>
<html lang="fr">
<head><%- include('partials/head', { title: bot.name }) %></head>
<body>
  <%- include('partials/nav', { user }) %>
  <main class="page">
    <div class="page-header">
      <div class="bot-title">
        <a href="/dashboard" class="back-link">&larr; Mes bots</a>
        <div class="bot-title-row">
          <img class="bot-avatar" src="<%= bot.avatar_url || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" />
          <div>
            <h1><%= bot.name %></h1>
            <% if (bot.username) { %><p class="bot-username">@<%= bot.username %></p><% } %>
          </div>
        </div>
      </div>
      <div class="bot-actions">
        <span class="status-dot status-<%= bot.status %>"></span>
        <span class="status-label status-label-<%= bot.status %>" id="status-label"><%= statusLabels[bot.status] || bot.status %></span>
        <form method="post" action="/bots/<%= bot.id %>/start" class="inline-form">
          <%- include('partials/csrf') %>
          <button class="btn btn-success" <%= bot.status === 'online' || bot.status === 'starting' ? 'disabled' : '' %>>▶ Démarrer</button>
        </form>
        <form method="post" action="/bots/<%= bot.id %>/stop" class="inline-form">
          <%- include('partials/csrf') %>
          <button class="btn btn-danger" <%= bot.status === 'stopped' ? 'disabled' : '' %>>■ Arrêter</button>
        </form>
      </div>
    </div>

    <%- include('partials/flash', { flash }) %>

    <% if (bot.last_error) { %>
      <div class="alert alert-error">Dernière erreur : <%= bot.last_error %></div>
    <% } %>

    <div class="stat-row">
      <div class="stat-tile"><span class="stat-value"><%= commands.length %></span><span class="stat-label">Commande(s)</span></div>
      <div class="stat-tile"><span class="stat-value"><%= bot.total_commands_run %></span><span class="stat-label">Exécutions totales</span></div>
      <div class="stat-tile"><span class="stat-value" id="guild-count"><%= guilds.length %></span><span class="stat-label">Serveur(s)</span></div>
      <div class="stat-tile">
        <span class="stat-value"><%= bot.status === 'online' && bot.started_at ? new Date(bot.started_at).toLocaleTimeString('fr-FR') : '—' %></span>
        <span class="stat-label">En ligne depuis</span>
      </div>
    </div>

    <div class="bot-layout">
      <section class="card">
        <div class="card-header"><h2>Paramètres</h2></div>
        <form method="post" action="/bots/<%= bot.id %>/settings" class="settings-form">
          <%- include('partials/csrf') %>
          <label>Nom
            <input type="text" name="name" value="<%= bot.name %>" required />
          </label>
          <label>Préfixe des commandes
            <input type="text" name="prefix" value="<%= bot.prefix %>" maxlength="5" required />
          </label>
          <p class="hint">Token : <code><%= maskedToken %></code> — <a href="/bots/<%= bot.id %>/token">changer le token</a></p>
          <button type="submit" class="btn btn-secondary">Enregistrer</button>
        </form>
        <% if (bot.client_id) { %>
          <a class="btn btn-primary btn-block" style="margin-top:14px;" target="_blank" rel="noopener" href="<%= inviteUrl %>">+ Inviter sur un serveur</a>
        <% } else { %>
          <p class="hint">Démarre le bot une première fois pour obtenir son lien d'invitation.</p>
        <% } %>
        <form method="post" action="/bots/<%= bot.id %>/delete" class="inline-form danger-zone"
              onsubmit="return confirm('Supprimer définitivement ce bot et toutes ses commandes ?');">
          <%- include('partials/csrf') %>
          <button type="submit" class="btn btn-ghost btn-danger-text">Supprimer ce bot</button>
        </form>
      </section>

      <section class="card">
        <div class="card-header"><h2>Serveurs (<span id="guild-count-2"><%= guilds.length %></span>)</h2></div>
        <ul class="guild-list" id="guild-list">
          <% guilds.forEach(g => { %>
            <li class="guild-item">
              <img src="<%= g.iconUrl || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" />
              <span class="guild-name"><%= g.name %></span>
              <span class="guild-members"><%= g.memberCount %> membre(s)</span>
            </li>
          <% }) %>
        </ul>
        <% if (!guilds.length) { %>
          <p class="empty-hint" id="guild-empty">
            <%= bot.status === 'online' ? "Ce bot n'a été ajouté à aucun serveur pour l'instant." : "Démarre le bot pour voir la liste de ses serveurs." %>
          </p>
        <% } %>
      </section>

      <section class="card">
        <div class="card-header">
          <h2>Modération intégrée</h2>
          <form method="post" action="/bots/<%= bot.id %>/moderation" class="inline-form">
            <%- include('partials/csrf') %>
            <input type="hidden" name="enabled" value="<%= bot.moderation_enabled ? '0' : '1' %>" />
            <button type="submit" class="btn btn-sm <%= bot.moderation_enabled ? 'btn-danger' : 'btn-success' %>">
              <%= bot.moderation_enabled ? 'Désactiver' : 'Activer' %>
            </button>
          </form>
        </div>
        <p class="hint" style="margin-top:0;">
          Ajoute automatiquement <code><%= bot.prefix %>kick</code>, <code><%= bot.prefix %>ban</code> et
          <code><%= bot.prefix %>clear</code>. Chaque commande vérifie les permissions Discord de la personne
          qui l'utilise ainsi que celles du bot avant d'agir.
        </p>
      </section>

      <section class="card">
        <div class="card-header"><h2>Message de bienvenue</h2></div>
        <form method="post" action="/bots/<%= bot.id %>/welcome" class="settings-form">
          <%- include('partials/csrf') %>
          <label class="checkbox-label">
            <input type="checkbox" name="enabled" <%= bot.welcome_enabled ? 'checked' : '' %> /> Envoyer un message quand un membre rejoint le serveur
          </label>
          <label>ID du salon
            <input type="text" name="channel_id" value="<%= bot.welcome_channel_id || '' %>" placeholder="Clic droit sur le salon → Copier l'ID" />
          </label>
          <label>Message
            <textarea name="message" rows="2"><%= bot.welcome_message %></textarea>
          </label>
          <p class="hint">Variables : <code>{user}</code> <code>{username}</code> <code>{server}</code> <code>{membercount}</code></p>
          <button type="submit" class="btn btn-secondary">Enregistrer</button>
        </form>
      </section>

      <section class="card">
        <div class="card-header"><h2>Message de départ</h2></div>
        <form method="post" action="/bots/<%= bot.id %>/leave" class="settings-form">
          <%- include('partials/csrf') %>
          <label class="checkbox-label">
            <input type="checkbox" name="enabled" <%= bot.leave_enabled ? 'checked' : '' %> /> Envoyer un message quand un membre quitte le serveur
          </label>
          <label>ID du salon
            <input type="text" name="channel_id" value="<%= bot.leave_channel_id || '' %>" placeholder="Clic droit sur le salon → Copier l'ID" />
          </label>
          <label>Message
            <textarea name="message" rows="2"><%= bot.leave_message %></textarea>
          </label>
          <button type="submit" class="btn btn-secondary">Enregistrer</button>
        </form>
      </section>

      <section class="card command-card">
        <div class="card-header">
          <h2>Commandes (<%= commands.length %>)</h2>
        </div>

        <form method="post" action="/bots/<%= bot.id %>/commands" class="command-form" id="command-form">
          <%- include('partials/csrf') %>
          <div class="command-form-row">
            <label>Type
              <select name="type">
                <option value="prefix">Préfixe (<%= bot.prefix %>bonjour)</option>
                <option value="slash">Slash (/bonjour)</option>
              </select>
            </label>
            <label>Déclencheur
              <input type="text" name="trigger" required placeholder="bonjour" pattern="[a-zA-Z0-9_-]+" />
            </label>
            <label>Cooldown (secondes)
              <input type="number" name="cooldown_seconds" min="0" max="3600" value="0" />
            </label>
          </div>
          <label>Description (affichée dans <%= bot.prefix %>help et sur Discord pour les commandes slash)
            <input type="text" name="description" placeholder="Dit bonjour à l'utilisateur" />
          </label>
          <label>Format de réponse
            <select name="response_type" id="response-type-select">
              <option value="text">Texte simple</option>
              <option value="embed">Embed (encadré coloré)</option>
            </select>
          </label>
          <div id="embed-fields" class="command-form-row" style="display:none;">
            <label>Titre de l'embed
              <input type="text" name="embed_title" placeholder="Titre (optionnel)" />
            </label>
            <label>Couleur
              <input type="color" name="embed_color" value="#5865F2" />
            </label>
          </div>
          <label>Réponse
            <textarea name="response" required placeholder="Bonjour {user} ! Bienvenue sur {server} 👋" rows="2"></textarea>
          </label>
          <p class="hint">Variables disponibles : <code>{user}</code> <code>{username}</code> <code>{server}</code> <code>{membercount}</code></p>
          <button type="submit" class="btn btn-primary">+ Ajouter la commande</button>
        </form>

        <% if (!commands.length) { %>
          <p class="empty-hint">Aucune commande pour l'instant. Ajoute-en une ci-dessus.</p>
        <% } else { %>
          <ul class="command-list">
            <% commands.forEach(cmd => { %>
              <li class="command-item <%= cmd.enabled ? '' : 'command-disabled' %>">
                <div class="command-item-main">
                  <span class="command-badge command-badge-<%= cmd.type %>"><%= cmd.type === 'slash' ? '/' : bot.prefix %><%= cmd.trigger %></span>
                  <% if (cmd.response_type === 'embed') { %><span class="command-badge command-badge-embed">embed</span><% } %>
                  <% if (cmd.cooldown_seconds > 0) { %><span class="command-badge command-badge-cooldown">⏳ <%= cmd.cooldown_seconds %>s</span><% } %>
                  <span class="command-desc"><%= cmd.description || 'Sans description' %></span>
                  <p class="command-response"><%= cmd.response %></p>
                  <p class="command-uses"><%= cmd.uses_count %> utilisation(s)<% if (cmd.last_used_at) { %> · dernière le <%= new Date(cmd.last_used_at).toLocaleString('fr-FR') %><% } %></p>
                </div>
                <div class="command-item-actions">
                  <form method="post" action="/bots/<%= bot.id %>/commands/<%= cmd.id %>/toggle" class="inline-form">
                    <%- include('partials/csrf') %>
                    <button type="submit" class="btn btn-ghost btn-sm"><%= cmd.enabled ? 'Désactiver' : 'Activer' %></button>
                  </form>
                  <form method="post" action="/bots/<%= bot.id %>/commands/<%= cmd.id %>/delete" class="inline-form"
                        onsubmit="return confirm('Supprimer cette commande ?');">
                    <%- include('partials/csrf') %>
                    <button type="submit" class="btn btn-ghost btn-danger-text btn-sm">Supprimer</button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="card logs-card">
        <div class="card-header">
          <h2>Logs en direct</h2>
          <span class="pulse-dot" id="live-indicator" title="Connexion en direct"></span>
        </div>
        <div id="log-console" class="log-console" data-bot-id="<%= bot.id %>">
          <% logs.forEach(l => { %>
            <div class="log-line log-<%= l.level %>"><span class="log-time"><%= new Date(l.ts).toLocaleTimeString('fr-FR') %></span><%= l.message %></div>
          <% }) %>
          <% if (!logs.length) { %>
            <div class="log-line log-info">Aucun log pour l'instant. Démarre le bot pour voir son activité ici.</div>
          <% } %>
        </div>
      </section>
    </div>
  </main>

  <script src="/js/bot.js"></script>
</body>
</html>
