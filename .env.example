# Port du serveur web
PORT=3000

# Clé secrète pour signer les cookies de session (chaîne aléatoire longue)
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Clé de chiffrement AES-256 pour stocker les tokens Discord en base
# Doit faire exactement 32 caractères. Génère-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-moi-64-caracteres-hexadecimaux-generes-avec-crypto-random

# Clé API Anthropic — active l'assistant IA des bots et le générateur de
# commandes par IA sur le site. Laisse vide pour désactiver ces fonctions
# (le reste du site continue de fonctionner normalement).
# Obtiens une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modèle Claude utilisé par les fonctions IA (optionnel, défaut : claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# NODE_ENV=production active les cookies de session sécurisés (HTTPS requis)
# NODE_ENV=production
