# Port du serveur web
PORT=3000

# Clé secrète pour signer les cookies de session (chaîne aléatoire longue)
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Clé de chiffrement AES-256 pour stocker les tokens Discord en base
# Doit faire exactement 32 caractères. Génère-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-moi-64-caracteres-hexadecimaux-generes-avec-crypto-random

# --- IA (facultatif) : active l'assistant IA des bots et le générateur de
# commandes par IA sur le site. Laisse tout vide pour désactiver ces
# fonctions (le reste du site continue de fonctionner normalement). Les 3
# options ci-dessous sont essayées dans l'ordre : Ollama > Groq > Claude.
#
# Option 1 (recommandée) — 100% GRATUITE, SANS AUCUNE CLÉ ni compte : Ollama,
# un modèle IA qui tourne en local sur ce serveur. Installation en une
# commande : bash deploy/install-ollama.sh (voir le README).
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Option 2 — GRATUITE mais nécessite un compte + une clé API (sans carte
# bancaire) : Groq. Utilisée seulement si OLLAMA_MODEL est vide.
# Crée une clé sur https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 3 (payante) : Claude (Anthropic), utilisée seulement si les deux
# options ci-dessus sont vides. Obtiens une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# NODE_ENV=production active les cookies de session sécurisés (HTTPS requis)
# NODE_ENV=production
