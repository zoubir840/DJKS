# Port du serveur web
PORT=3000

# Clé secrète pour signer les cookies de session (chaîne aléatoire longue)
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Clé de chiffrement AES-256 pour stocker les tokens Discord en base
# Doit faire exactement 32 caractères. Génère-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-moi-64-caracteres-hexadecimaux-generes-avec-crypto-random
